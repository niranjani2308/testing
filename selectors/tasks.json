{
  "taskSection": {
    "todayTab": "button:has-text('Today')",
    "myPlansTab": "button:has-text('My Plans')",
    "newManualTaskBtn": "button:has-text('New Task')",
    "aiPlanGeneratorBtn": "button:has-text('AI Plan Generator'), button:has-text('Plan with AI')",
    "searchInput": "input[placeholder*='Search tasks']",
    "todayOnlyFilter": "button:has-text('Today Only')",
    "allDatesFilter": "button:has-text('All Dates')",
    "filterAll": "button:has-text('All')",
    "filterPending": "button:has-text('Pending')",
    "filterInProgress": "button:has-text('In Progress')",
    "filterOverdue": "button:has-text('Overdue')",
    "filterCompleted": "button:has-text('Completed')",
    "taskCard": "div.group:has(h3), div.bg-white:has(h3)",
    "taskTitle": "h3",
    "statusCheckbox": "button[title*='status'], button:has(svg.lucide-check), input[type='checkbox']",
    "priorityBadge": "span:has-text('HIGH'), span:has-text('MEDIUM'), span:has-text('LOW')",
    "dueDate": "span:has(svg.lucide-calendar)",
    "rescheduleBtn": "button[title*='Reschedule'], button:has(svg.lucide-calendar-days)",
    "rescheduleDateInput": "input[type='date']",
    "editTaskBtn": "button[title='Edit Task'], button:has(svg.lucide-edit-2)",
    "deleteTaskBtn": "button[title='Delete Task'], button:has(svg.lucide-trash-2)",
    "askAiCoachBtn": "button:has-text('Ask AI Coach'), button:has-text('Coach')"
  },
  "manualTaskModal": {
    "modal": "div:has-text('New Task'), div:has-text('Edit Task')",
    "titleInput": "input[placeholder*='task title'], input[name='title']",
    "descriptionInput": "textarea[placeholder*='description']",
    "dateInput": "input[type='date']",
    "prioritySelect": "select[name='priority'], div:has-text('Priority') select",
    "statusSelect": "select[name='status'], div:has-text('Status') select",
    "notesInput": "textarea[placeholder*='notes']",
    "submitBtn": "button[type='submit']",
    "cancelBtn": "button:has-text('Cancel')"
  },
  "aiPlanSection": {
    "modal": "div:has-text('AI Plan Generator')",
    "descriptionInput": "textarea[placeholder*='accomplish']",
    "startDateInput": "input[type='date']",
    "deadlineInput": "input[placeholder*='10 days']",
    "continueBtn": "button:has-text('Continue to Clarification'), button:has-text('Next')",
    "clarificationInput": "input[placeholder*='Your answer']",
    "generatePlanBtn": "button:has-text('Generate Plan')",
    "previewModal": "div:has-text('Plan Preview')",
    "approvePlanBtn": "button:has-text('Approve Plan'), button:has-text('Save Plan')"
  },
  "copilotSection": {
    "copilotDrawer": "div:has-text('LifeTrack AI Copilot')",
    "copilotInput": "input[placeholder*='Ask Copilot'], textarea[placeholder*='Ask Copilot']",
    "copilotSendBtn": "button:has(svg.lucide-send)",
    "copilotCloseBtn": "div:has-text('LifeTrack AI Copilot') button:has(svg.lucide-x)"
  }
}
