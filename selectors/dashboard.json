{
  "dashboardOverview": {
    "greetingTitle": "h1",
    "currentDate": "p:has(svg)",
    "refreshBtn": "button[title='Refresh dashboard metrics']",
    "exportBtn": "button:has-text('Export')",
    "newTaskBtn": "header button:has-text('New Task')",
    "refreshToast": "div:has-text('Dashboard metrics refreshed successfully')",
    "overviewTab": "button[role='tab']:has-text('Overview')",
    "analyticsTab": "button[role='tab']:has-text('Analytics')",
    "overdueBanner": "div.bg-amber-50\\/90, div:has-text('overdue task')",
    "reviewOverdueBtn": "button:has-text('Review Overdue')",
    "cardTotalJourneys": "div:has(span:has-text('Journeys')):has(div.text-xl)",
    "cardTotalTasks": "div:has(span:has-text('Total Tasks')):has(div.text-xl)",
    "cardCompletedTasks": "div:has(span:has-text('Completed')):has(div.text-xl)",
    "cardPendingTasks": "div:has(span:has-text('Pending')):has(div.text-xl)",
    "cardTotalNotes": "div:has(span:has-text('Notes')):has(div.text-xl)",
    "cardTotalFiles": "div:has(span:has-text('Total Files')):has(div.text-xl)"
  },
  "analyticsSection": {
    "filter7Days": "button:has-text('Last 7 Days')",
    "filter14Days": "button:has-text('Last 14 Days')",
    "filter30Days": "button:has-text('Last 30 Days')",
    "filterAllTime": "button:has-text('All Time')",
    "chartTaskStatus": "div:has-text('Task Status Distribution')",
    "chartFileType": "div:has-text('File Types')",
    "chartDailyActivity": "div:has-text('Daily Activity Trends')",
    "chartJourneyProgress": "div:has-text('Journey Progress')"
  },
  "drawerSection": {
    "drawer": "div.fixed.inset-y-0.right-0",
    "drawerTitle": "h2",
    "drawerCloseBtn": "div.fixed.inset-y-0.right-0 button:has(svg)",
    "drawerRecords": "div.space-y-3 > div, div.p-4.rounded-xl"
  },
  "exportModal": {
    "modal": "div:has-text('Export Dashboard Data')",
    "scopeCurrentTab": "input[value='CURRENT_TAB']",
    "scopeFullReport": "input[value='FULL_REPORT']",
    "formatPdf": "button:has-text('PDF Document')",
    "formatExcel": "button:has-text('Excel Workbook')",
    "formatCsv": "button:has-text('CSV Spreadsheet')",
    "submitExportBtn": "button:has-text('Export & Download')",
    "closeExportModalBtn": "div.fixed.inset-0 button:has(svg)"
  }
}
